---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date | string;
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;
const date = frontmatter.pubDate instanceof Date
  ? frontmatter.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : frontmatter.pubDate;
---

<BaseLayout title={`${frontmatter.title} · Kyle Xu`} description={frontmatter.description}>
  <header class="top">
    <a class="brand" href="/">KX / Kyle Xu</a>
    <nav aria-label="站点导航"><a href="/">首页</a><a href="/#articles">文章</a></nav>
  </header>
  <main class="article-wrap">
    <header class="article-head">
      <a class="mono back" href="/">← 返回首页</a>
      <h1>{frontmatter.title}</h1>
      <p class="description">{frontmatter.description}</p>
      <div class="article-meta">
        <time>{date}</time>
        {frontmatter.tags?.map((tag) => <span class="article-tag">{tag}</span>)}
      </div>
    </header>
    <article class="prose"><slot /></article>
    <footer class="article-foot"><a href="/">← 更多文章</a></footer>
  </main>
</BaseLayout>

<style>
  .article-wrap { max-width: 900px; margin: 0 auto; padding: 48px 28px 80px; }
  .article-head { max-width: 720px; margin: 0 auto 36px; padding-bottom: 25px; border-bottom: 2px solid var(--rule); }
  .back { color: var(--accent); }
  .article-head h1 { margin: 20px 0 10px; font: 600 clamp(34px, 6vw, 54px)/1.12 var(--serif); letter-spacing: -.045em; }
  .description { color: var(--muted); font-size: 16px; margin: 0 0 15px; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; color: var(--faint); font: 11px var(--mono); }
  .article-tag { padding: 3px 9px; border: 1px solid rgba(255,255,255,.85); border-radius: 99px; background: rgba(255,255,255,.55); }
  .prose { max-width: 720px; margin: 0 auto; color: var(--ink); font-size: 16px; line-height: 1.9; }
  .prose h2 { margin: 42px 0 15px; padding-bottom: 8px; border-bottom: 1px solid var(--line); font: 600 25px/1.3 var(--serif); }
  .prose h3 { margin: 25px 0 5px; font: 600 18px/1.45 var(--serif); }
  .prose p { margin: 8px 0 15px; color: var(--muted); }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .prose a:hover { color: var(--ink); }
  .article-foot { max-width: 720px; margin: 45px auto 0; padding-top: 17px; border-top: 1px solid var(--line); font: 12px var(--mono); color: var(--accent); }
  @media (max-width: 600px) { .article-wrap { padding: 32px 20px 55px; } .prose { font-size: 15px; } }
</style>
