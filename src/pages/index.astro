---
import BaseLayout from '../layouts/BaseLayout.astro';

interface BlogPost {
  frontmatter: {
    title: string;
    pubDate: string | Date;
    description: string;
    tags?: string[];
  };
  url: string;
}

const modules = import.meta.glob('./posts/*.md', { eager: true }) as Record<string, BlogPost>;
const posts = Object.entries(modules)
  .map(([path, post]) => ({
    ...post.frontmatter,
    url: `/posts/${path.split('/').pop()?.slice(0, -3)}/`,
    pubDate: new Date(post.frontmatter.pubDate),
    tags: post.frontmatter.tags ?? [],
  }))
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const quotes = [
  { text: '行到水穷处，坐看云起时。', author: '王维', work: '《终南别业》' },
  { text: '明月松间照，清泉石上流。', author: '王维', work: '《山居秋暝》' },
  { text: '晚来天欲雪，能饮一杯无。', author: '白居易', work: '《问刘十九》' },
  { text: '此心安处是吾乡。', author: '苏轼', work: '《定风波》' },
  { text: '采菊东篱下，悠然见南山。', author: '陶渊明', work: '《饮酒·其五》' },
  { text: '蝉噪林逾静，鸟鸣山更幽。', author: '王籍', work: '《入若耶溪》' },
  { text: '春水碧于天，画船听雨眠。', author: '韦庄', work: '《菩萨蛮》' },
  { text: '人间有味是清欢。', author: '苏轼', work: '《浣溪沙》' },
];
const quote = quotes[Math.floor(Math.random() * quotes.length)];
const latestPost = posts[0];
const dateLabel = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Kyle Xu · 随笔与收藏"
  description="Kyle Xu 的个人博客，记录随笔、项目与收藏。"
>
  <header class="top">
    <a class="brand" href="/">KX / Kyle Xu</a>
    <nav aria-label="站点导航"><a href="/#articles">文章</a><a href={latestPost?.url ?? '/'}>最新</a></nav>
  </header>

  <main class="wrap">
    <section class="hero">
      <div>
        <span class="mono">NOTES · LINKS · IDEAS</span>
        <h1>Kyle Xu</h1>
        <p class="lead">随笔、项目与值得收藏的东西。</p>
      </div>
      <div>
        <p class="quote">{quote.text}</p>
        <p class="credit">— {quote.author} · {quote.work}</p>
      </div>
    </section>

    <section class="posts" id="articles" aria-labelledby="posts-title">
      <div class="section-head">
        <h2 id="posts-title">文章</h2>
        <span class="mono">{posts.length} POSTS</span>
      </div>
      {posts.length ? posts.map((post, index) => (
        <a class="post" href={post.url}>
          <span class="post-no">{String(index + 1).padStart(2, '0')}</span>
          <span class="post-body">
            <span class="post-meta"><time datetime={post.pubDate.toISOString()}>{dateLabel(post.pubDate)}</time></span>
            <strong>{post.title}</strong>
            <span class="post-description">{post.description}</span>
            {post.tags.length > 0 && <span class="post-tags">{post.tags.map((tag) => <span>{tag}</span>)}</span>}
          </span>
          <span class="post-arrow" aria-hidden="true">↗</span>
        </a>
      )) : <p class="empty">还没有文章，第一篇 Markdown 发布后会显示在这里。</p>}
    </section>

    <footer class="foot"><span>KYLE XU</span><a href="/posts/bookmarks/">查看收藏文章 ↗</a></footer>
  </main>

  <style>
    .wrap { max-width: 960px; margin: 0 auto; padding: 48px 5% 72px; }
    .hero { display: grid; grid-template-columns: 1.2fr .8fr; gap: 38px; align-items: end; padding: 18px 0 32px; border-bottom: 2px solid var(--rule); }
    .hero h1 { margin: 14px 0 7px; font: 600 clamp(42px, 7vw, 68px)/1 var(--serif); letter-spacing: -.055em; }
    .lead { margin: 0; color: var(--muted); font-size: 16px; }
    .quote { margin: 0 0 8px; font: 24px/1.4 var(--serif); }
    .credit { margin: 0; color: var(--faint); font: 11px var(--mono); }
    .posts { margin-top: 38px; }
    .section-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #bcb7aa; padding-bottom: 10px; }
    .section-head h2 { margin: 0; font: 600 21px var(--serif); }
    .post { display: grid; grid-template-columns: 34px minmax(0, 1fr) 20px; gap: 15px; padding: 20px 8px 20px 0; border-bottom: 1px solid var(--line); transition: background .18s; }
    .post:hover { background: rgba(255,255,255,.5); text-decoration: none; }
    .post-no { padding-top: 4px; color: var(--faint); text-align: right; font: 11px var(--mono); }
    .post-body { display: grid; gap: 5px; }
    .post-meta { color: var(--faint); font: 11px var(--mono); }
    .post strong { font: 600 19px/1.4 var(--serif); }
    .post-description { color: var(--muted); font-size: 14px; }
    .post-tags { display: flex; gap: 6px; margin-top: 4px; }
    .post-tags span { padding: 2px 9px; border-radius: 99px; background: var(--accent-soft); color: #6a452f; font: 10px var(--mono); }
    .post-arrow { align-self: center; color: var(--accent); font: 14px var(--mono); }
    .empty { padding: 25px 0; color: var(--muted); }
    .foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 42px; padding-top: 15px; border-top: 1px solid var(--line); color: var(--faint); font: 11px var(--mono); }
    .foot a { color: var(--accent); }
    @media (max-width: 640px) { .wrap { padding-top: 32px; } .hero { grid-template-columns: 1fr; gap: 20px; } .post { grid-template-columns: 26px minmax(0,1fr) 16px; gap: 10px; } }
  </style>
</BaseLayout>
